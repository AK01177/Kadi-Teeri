# API URL (Leave blank for same origin, set to backend URL in production if hosted separately)
# Example: https://kadi-teeri-backend-xyz.run.app
VITE_API_URL=

# WebSocket URL (Leave blank to use wss://<origin>, set to backend URL in production)
# Example: wss://kadi-teeri-backend-xyz.run.app
VITE_WS_URL=
